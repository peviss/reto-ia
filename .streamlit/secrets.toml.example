# Copia este archivo como secrets.toml y pega tu clave (https://aistudio.google.com/apikey).
# secrets.toml NO se sube a GitHub. En Streamlit Cloud: Settings -> Secrets.
GEMINI_API_KEY = "pega-aqui-tu-clave"
# Opcional: modelo de reserva (Claude) si Gemini falla (https://console.anthropic.com/settings/keys).
ANTHROPIC_API_KEY = "pega-aqui-tu-clave-de-anthropic"
# Opcional: «📤 → Google Drive» deja que cada usuario guarde el cuadre en SU Google Drive, entrando con su cuenta.
# Google Cloud → API de Google Drive activada → Credenciales → ID de cliente OAuth de tipo «Aplicación web»,
# con orígenes de JavaScript autorizados: https://reto-ia-peviss.streamlit.app y http://localhost:8501.
# Pantalla de consentimiento con el permiso «drive.file». El client_id no es secreto; no hace falta client_secret.
# Sin esta sección, ese destino no sale y solo queda «Integración propia».
# [google_drive]
# client_id = "pega-aqui-el-client-id.apps.googleusercontent.com"
